# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials to Git.

# Application: public origin used in auth email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: project URL and publishable key are designed to be used by the client.
# Local stack: run `npm run db:start` then `npm run db:env` to generate .env.local automatically.
# Hosted: Project Settings -> API Keys. Never put the secret/service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional Google Calendar integration. Leave blank until the integration is configured.
# Configure an OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Generate a strong random key, e.g. `openssl rand -base64 32`.
# Server-only. Used to encrypt Google refresh tokens before storing them.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional feature switch. The application must still work when false. When true, every
# GOOGLE_* value above must be set and valid, or the integration stays off. See the README.
GOOGLE_CALENDAR_INTEGRATION_ENABLED=false

# Tests only: send all Google traffic to a local mock (loopback http:// origins only).
# GOOGLE_API_ORIGIN_OVERRIDE=http://127.0.0.1:4010
